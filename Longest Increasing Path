class Solution {
    public int longestIncreasingPath(int[][] matrix) {
        int m = matrix.length;
        int n = matrix[0].length;
        int[][] dp = new int[m][n];

        int ans = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                ans = Math.max(ans, dfs(matrix, i, j, dp));
            }
        }

        return ans;
    }

    private int dfs(int[][] matrix, int row, int col, int[][] dp) {
        if (dp[row][col] != 0) {
            return dp[row][col];
        }

        int m = matrix.length;
        int n = matrix[0].length;

        int max = 1;

        int[][] dir = {{1,0},{-1,0},{0,1},{0,-1}};

        for (int[] d : dir) {
            int nr = row + d[0];
            int nc = col + d[1];

            if (nr >= 0 && nc >= 0 && nr < m && nc < n &&
                matrix[nr][nc] > matrix[row][col]) {
                max = Math.max(max, 1 + dfs(matrix, nr, nc, dp));
            }
        }

        return dp[row][col] = max;
    }
}
